---
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Path relative to the site base, e.g. "privacy/". */
  path?: string;
  /** Extra JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  home?: boolean;
}

const {
  title = 'Shadow: live pair programming in your own editor',
  description =
    'Shadow syncs a project folder between two machines in real time, end to end encrypted. Pair from VS Code, Neovim, Vim, JetBrains, or Zed. Free Mac app and CLI, no accounts.',
  path = '',
  schema = [],
  noindex = false,
  home = true,
} = Astro.props;

const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const siteOrigin = Astro.site ?? new URL('https://go-johnnyhe.github.io');
const canonicalUrl = new URL(base + path, siteOrigin).toString();
const ogImage = new URL(`${base}og.png`, siteOrigin).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#131209" />
    <meta name="color-scheme" content="dark" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Shadow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Shadow: pair program live without leaving your editor" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}shadow-icon.png`} />
    <title>{title}</title>

    <script is:inline>document.documentElement.classList.add('js');</script>

    {schema.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}

    <!-- PostHog Analytics -->
    <script is:inline define:vars={{ posthogKey }}>
      (function () {
        var hasKey = typeof posthogKey === 'string' && posthogKey.length > 0;

        window.shadowAnalytics = {
          enabled: hasKey,
          capture: function (eventName, properties) {
            try {
              if (hasKey && window.posthog && typeof window.posthog.capture === 'function') {
                window.posthog.capture(eventName, properties);
              }
            } catch (_) {}
          },
        };

        if (!hasKey) return;

        !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
        posthog.init(posthogKey, {
          api_host: 'https://us.i.posthog.com',
          person_profiles: 'identified_only',
        });
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Nav home={home} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      function shadowCapture(eventName, properties) {
        if (window.shadowAnalytics && typeof window.shadowAnalytics.capture === 'function') {
          window.shadowAnalytics.capture(eventName, properties);
        }
      }

      function updateCopyButtonState(button, state) {
        if (!button) return;
        button.dataset.copyState = state;
        var label = button.querySelector('[data-copy-label]');
        if (label) {
          if (!button.dataset.defaultLabel) button.dataset.defaultLabel = label.textContent || 'Copy';
          label.textContent = state === 'copied' ? 'Copied' : button.dataset.defaultLabel;
        }
        var wrap = button.parentElement && button.parentElement.parentElement;
        var error = wrap && wrap.querySelector('[data-copy-error]');
        if (error) {
          error.textContent =
            state === 'failed' ? 'Copy failed. Select the command and press Command C instead.' : '';
        }
      }

      async function copyText(text) {
        if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
          try {
            await navigator.clipboard.writeText(text);
            return true;
          } catch (_) {}
        }

        var textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();

        try {
          return document.execCommand('copy');
        } catch (_) {
          return false;
        } finally {
          document.body.removeChild(textarea);
        }
      }

      document.addEventListener('DOMContentLoaded', () => {
        shadowCapture('landing_page_viewed', { surface: 'website' });

        var reveals = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) {
          reveals.forEach((el) => el.classList.add('is-visible'));
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -64px 0px' }
        );
        reveals.forEach((el) => io.observe(el));
      });

      document.addEventListener('click', async (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const cta = target.closest('[data-cta]');
        if (cta) {
          shadowCapture('cta_clicked', {
            source: cta.getAttribute('data-cta-source') || 'unknown',
            target: cta.getAttribute('data-cta-target') || 'unknown',
            surface: cta.getAttribute('data-cta-surface') || 'website',
          });
        }

        const copyButton = target.closest('[data-copy-text]');
        if (copyButton instanceof HTMLButtonElement) {
          var text = copyButton.getAttribute('data-copy-text') || '';
          if (!text) return;

          var didCopy = false;
          try {
            didCopy = await copyText(text);
          } catch (_) {}

          if (!didCopy) {
            updateCopyButtonState(copyButton, 'failed');
            return;
          }

          updateCopyButtonState(copyButton, 'copied');
          shadowCapture('install_command_copied', {
            source: copyButton.getAttribute('data-copy-source') || 'unknown',
            target: copyButton.getAttribute('data-copy-target') || 'unknown',
            surface: copyButton.getAttribute('data-copy-surface') || 'website',
          });
          window.setTimeout(function () {
            updateCopyButtonState(copyButton, 'idle');
          }, 1800);
        }

        const demoToggle = target.closest('[data-demo-toggle]');
        if (demoToggle instanceof HTMLButtonElement) {
          const demoRoot = demoToggle.closest('[data-demo-root]');
          const video = demoRoot && demoRoot.querySelector('[data-demo-video]');
          if (!(video instanceof HTMLVideoElement)) return;

          const resume = video.paused;
          if (resume) void video.play();
          else video.pause();
          demoToggle.dataset.demoState = resume ? 'playing' : 'paused';
          demoToggle.setAttribute('aria-label', resume ? 'Pause demo video' : 'Play demo video');
          shadowCapture('demo_interacted', {
            source: demoToggle.getAttribute('data-demo-source') || 'unknown',
            action: resume ? 'resume' : 'pause',
            surface: 'website',
          });
        }
      });
    </script>
  </body>
</html>
