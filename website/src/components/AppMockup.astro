---
// A replica of the Shadow menu bar popover. Its state follows the nearest
// ancestor's data-step: 1 idle (Start Session gets pressed), 2 sharing with the
// invite copied, 3 files syncing. Only opacity and transform animate, and the
// layout never shifts between states.
import Icon from './Icon.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const activity = ['lexer/lexer.go', 'lexer/token.go', 'lexer/lexer_test.go'];
---

<div class="popover" aria-hidden="true">
  <div class="layers">
    <!-- Idle -->
    <div class="layer layer-idle">
      <div class="pop-head">
        <img src={`${base}shadow-icon.png`} alt="" width="32" height="32" loading="lazy" decoding="async" />
        <div>
          <p class="pop-title">Shadow</p>
          <p class="pop-sub">Encrypted realtime collaboration</p>
        </div>
      </div>

      <div class="pop-buttons">
        <span class="mac-btn mac-btn-blue start-btn">Start Session</span>
        <span class="mac-btn">Join Session</span>
      </div>

      <div class="pop-toggle">
        <span class="switch"><span></span></span>
        <span>Joiners are read only</span>
      </div>

      <div class="pop-empty">
        <Icon name="folder-simple" size={16} />
        <span>No session running. Pick a folder to share.</span>
      </div>

      <p class="pop-foot">
        <Icon name="lock-simple" size={12} />
        The relay never sees your code.
      </p>
    </div>

    <!-- Active -->
    <div class="layer layer-active">
      <div class="pop-head">
        <span class="live-dot"></span>
        <div>
          <p class="pop-title">Sharing</p>
          <p class="pop-sub">Invite link copied to clipboard</p>
        </div>
      </div>

      <dl class="pop-rows">
        <div><dt>Directory</dt><dd>lexer</dd></div>
        <div><dt>Permissions</dt><dd>Everyone can edit</dd></div>
        <div><dt>Security</dt><dd>E2E encrypted</dd></div>
      </dl>

      <div class="pop-activity">
        <p class="pop-label">Recent activity</p>
        <div class="activity-box">
          <p class="activity-empty">Waiting for your partner to join</p>
          <ul>
            {activity.map((file, i) => (
              <li style={`--n:${i}`}>
                <Icon name="arrows-left-right" size={12} />
                <span>{file}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="pop-buttons">
        <span class="mac-btn invite-btn">Copy Invite Link</span>
        <span class="mac-btn mac-btn-stop">Stop Session</span>
      </div>
    </div>
  </div>
</div>

<style>
  .popover {
    width: 288px;
    padding: var(--sp-100);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-xl);
    background: rgba(39, 39, 39, 0.96);
    box-shadow: var(--shadow-lg);
    font-size: var(--text-xs);
    line-height: var(--lh-xs);
    color: var(--text-secondary);
  }

  .layers {
    display: grid;
  }

  .layer {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: var(--sp-100);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .pop-head {
    display: flex;
    align-items: center;
    gap: var(--sp-75);
  }

  .pop-head img {
    border-radius: var(--r-lg);
  }

  .pop-title {
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
    font-weight: 600;
    color: var(--text);
  }

  .pop-sub {
    color: var(--text-muted);
  }

  .pop-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-75);
  }

  .mac-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-50) var(--sp-75);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.08);
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
  }

  .mac-btn-blue {
    border-color: #0a84ff;
    background: #0a84ff;
    color: #fff;
  }

  .mac-btn-stop {
    color: #ff8a80;
  }

  .pop-toggle {
    display: flex;
    align-items: center;
    gap: var(--sp-75);
  }

  .switch {
    display: flex;
    align-items: center;
    width: 24px;
    height: 16px;
    padding: var(--sp-25);
    border-radius: var(--r-full);
    background: rgba(255, 255, 255, 0.16);
  }

  .switch span {
    width: 12px;
    height: 12px;
    border-radius: var(--r-full);
    background: #e5e5e5;
  }

  .pop-empty {
    display: flex;
    align-items: center;
    gap: var(--sp-75);
    padding: var(--sp-75);
    border: 1px dashed var(--border-strong);
    border-radius: var(--r-lg);
    color: var(--text-muted);
  }

  .pop-empty svg {
    flex-shrink: 0;
  }

  .pop-foot {
    display: flex;
    align-items: center;
    gap: var(--sp-50);
    margin-top: auto;
    color: var(--text-muted);
  }

  .live-dot {
    position: relative;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: var(--r-lg);
    background: rgba(50, 215, 75, 0.12);
  }

  .live-dot::before,
  .live-dot::after {
    content: '';
    position: absolute;
    inset: var(--sp-100);
    border-radius: var(--r-full);
    background: var(--live);
  }

  .pop-rows {
    display: grid;
    gap: var(--sp-50);
    padding: var(--sp-75);
    border-radius: var(--r-lg);
    background: rgba(0, 0, 0, 0.28);
  }

  .pop-rows div {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-75);
  }

  .pop-rows dt {
    color: var(--text-muted);
  }

  .pop-rows dd {
    color: var(--text);
  }

  .pop-label {
    margin-bottom: var(--sp-50);
    font-weight: 500;
    color: var(--text-muted);
  }

  .activity-box {
    display: grid;
  }

  .activity-empty,
  .pop-activity ul {
    grid-area: 1 / 1;
    transition: opacity var(--dur) var(--ease);
  }

  .activity-empty {
    align-self: center;
    color: var(--text-muted);
  }

  .pop-activity ul {
    display: grid;
    gap: var(--sp-50);
    list-style: none;
    font-family: var(--font-mono);
    color: var(--text-secondary);
  }

  .pop-activity li {
    display: flex;
    align-items: center;
    gap: var(--sp-75);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .pop-activity li svg {
    color: var(--accent);
  }

  /* ---- States. With no data-step the final, fully synced state shows. ---- */
  .layer-idle {
    opacity: 0;
    transform: scale(0.98);
  }

  .activity-empty {
    opacity: 0;
  }

  :global([data-step='1']) .layer-idle {
    opacity: 1;
    transform: none;
  }

  :global([data-step='1']) .layer-active {
    opacity: 0;
    transform: translateY(var(--sp-75));
  }

  :global([data-step='1']) .start-btn {
    animation: press 1600ms var(--ease) 1200ms both;
  }

  :global([data-step='2']) .activity-empty {
    opacity: 1;
  }

  :global([data-step='1']) .pop-activity li,
  :global([data-step='2']) .pop-activity li {
    opacity: 0;
    transform: translateY(var(--sp-50));
  }

  :global([data-step='2']) .invite-btn {
    animation: flash 1600ms var(--ease) 300ms both;
  }

  :global([data-step='3']) .pop-activity li {
    transition-delay: calc(400ms + var(--n) * 600ms);
  }

  :global([data-step='3']) .live-dot::after {
    animation: live-ping 1.8s var(--ease) infinite;
  }

  @keyframes press {
    0%, 100% { transform: none; }
    20% { transform: scale(0.94); }
    40% { transform: none; }
  }

  @keyframes flash {
    0%, 100% { background-color: rgba(255, 255, 255, 0.08); }
    30% { background-color: rgba(255, 255, 255, 0.2); }
  }

  @keyframes live-ping {
    0% { opacity: 0.6; transform: scale(1); }
    80%, 100% { opacity: 0; transform: scale(2.6); }
  }

  @media (prefers-reduced-motion: reduce) {
    .layer,
    .pop-activity li {
      transform: none !important;
    }

    :global([data-step='1']) .start-btn,
    :global([data-step='3']) .live-dot::after {
      animation: none;
    }
  }
</style>
