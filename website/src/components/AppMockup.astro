---
// A replica of the Shadow menu bar popover. It loops through the real flow:
// idle, press Start Session, then the live "Sharing" view as files sync.
// Only opacity and transform animate, and the layout never shifts.
import Icon from './Icon.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const activity = ['lexer/lexer.go', 'lexer/token.go', 'lexer/lexer_test.go'];
---

<div class="popover" role="img" aria-label="The Shadow menu bar app. Clicking Start Session shares the lexer folder and shows files syncing.">
  <div class="layers" aria-hidden="true">
    <!-- Idle -->
    <div class="layer layer-idle">
      <div class="pop-head">
        <img src={`${base}shadow-icon.png`} alt="" width="32" height="32" />
        <div>
          <p class="pop-title">Shadow</p>
          <p class="pop-sub">Encrypted realtime collaboration</p>
        </div>
      </div>

      <div class="pop-buttons">
        <span class="mac-btn mac-btn-blue start-btn">Start Session</span>
        <span class="mac-btn">Join Session</span>
      </div>

      <div class="pop-toggle">
        <span class="switch"><span></span></span>
        <span>Joiners are read only</span>
      </div>

      <div class="pop-empty">
        <Icon name="folder-simple" size={16} />
        <span>No session running. Pick a folder to share.</span>
      </div>

      <p class="pop-foot">
        <Icon name="lock-simple" size={12} />
        The relay never sees your code.
      </p>
    </div>

    <!-- Active -->
    <div class="layer layer-active">
      <div class="pop-head">
        <span class="live-dot"></span>
        <div>
          <p class="pop-title">Sharing</p>
          <p class="pop-sub">Invite link copied to clipboard</p>
        </div>
      </div>

      <dl class="pop-rows">
        <div><dt>Directory</dt><dd>lexer</dd></div>
        <div><dt>Permissions</dt><dd>Everyone can edit</dd></div>
        <div><dt>Security</dt><dd>E2E encrypted</dd></div>
      </dl>

      <div class="pop-activity">
        <p class="pop-label">Recent activity</p>
        <ul>
          {activity.map((file, i) => (
            <li style={`--n:${i}`}>
              <Icon name="arrows-left-right" size={12} />
              <span>{file}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="pop-buttons">
        <span class="mac-btn">Copy Invite Link</span>
        <span class="mac-btn mac-btn-stop">Stop Session</span>
      </div>
    </div>
  </div>
</div>

<style>
  .popover {
    width: 288px;
    padding: var(--sp-100);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-xl);
    background: rgba(39, 39, 39, 0.96);
    backdrop-filter: blur(20px) saturate(1.5);
    box-shadow: var(--shadow-lg);
    font-size: var(--text-xs);
    line-height: var(--lh-xs);
    color: var(--text-secondary);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .popover { -webkit-backdrop-filter: blur(20px) saturate(1.5); }
  }

  .layers {
    display: grid;
  }

  .layer {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: var(--sp-100);
  }

  .pop-head {
    display: flex;
    align-items: center;
    gap: var(--sp-75);
  }

  .pop-head img {
    border-radius: var(--r-lg);
  }

  .pop-title {
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
    font-weight: 600;
    color: var(--text);
  }

  .pop-sub {
    color: var(--text-muted);
  }

  .pop-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-75);
  }

  .mac-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-50) var(--sp-75);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.08);
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
  }

  .mac-btn-blue {
    border-color: #0a84ff;
    background: #0a84ff;
    color: #fff;
  }

  .mac-btn-stop {
    color: #ff8a80;
  }

  .pop-toggle {
    display: flex;
    align-items: center;
    gap: var(--sp-75);
  }

  .switch {
    display: flex;
    align-items: center;
    width: 24px;
    height: 16px;
    padding: var(--sp-25);
    border-radius: var(--r-full);
    background: rgba(255, 255, 255, 0.16);
  }

  .switch span {
    width: 12px;
    height: 12px;
    border-radius: var(--r-full);
    background: #e5e5e5;
  }

  .pop-empty {
    display: flex;
    align-items: center;
    gap: var(--sp-75);
    padding: var(--sp-75);
    border: 1px dashed var(--border-strong);
    border-radius: var(--r-lg);
    color: var(--text-muted);
  }

  .pop-empty svg {
    flex-shrink: 0;
  }

  .pop-foot {
    display: flex;
    align-items: center;
    gap: var(--sp-50);
    margin-top: auto;
    color: var(--text-muted);
  }

  .live-dot {
    position: relative;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: var(--r-lg);
    background: rgba(50, 215, 75, 0.12);
  }

  .live-dot::before,
  .live-dot::after {
    content: '';
    position: absolute;
    inset: var(--sp-100);
    border-radius: var(--r-full);
    background: var(--live);
  }

  .live-dot::after {
    animation: live-ping 1.8s var(--ease) infinite;
  }

  .pop-rows {
    display: grid;
    gap: var(--sp-50);
    padding: var(--sp-75);
    border-radius: var(--r-lg);
    background: rgba(0, 0, 0, 0.28);
  }

  .pop-rows div {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-75);
  }

  .pop-rows dt {
    color: var(--text-muted);
  }

  .pop-rows dd {
    color: var(--text);
  }

  .pop-label {
    margin-bottom: var(--sp-50);
    font-weight: 500;
    color: var(--text-muted);
  }

  .pop-activity ul {
    display: grid;
    gap: var(--sp-50);
    list-style: none;
    font-family: var(--font-mono);
    color: var(--text-secondary);
  }

  .pop-activity li {
    display: flex;
    align-items: center;
    gap: var(--sp-75);
  }

  .pop-activity li svg {
    color: var(--accent);
  }

  /* ---- Loop: 10s. Idle, press Start, share, files arrive, reset ---- */
  @media (prefers-reduced-motion: no-preference) {
    .layer-idle { animation: idle-layer 10s var(--ease) infinite; }
    .layer-active { animation: active-layer 10s var(--ease) infinite; }
    .start-btn { animation: press 10s var(--ease) infinite; }
    .pop-activity li { animation: file-in 10s var(--ease) infinite; }
    .pop-activity li:nth-child(2) { animation-name: file-in-2; }
    .pop-activity li:nth-child(3) { animation-name: file-in-3; }
  }

  @media (prefers-reduced-motion: reduce) {
    .layer-idle { opacity: 0; }
  }

  .layer-active { opacity: 0; }

  @keyframes press {
    0%, 18%, 100% { transform: none; }
    21% { transform: scale(0.94); }
    25% { transform: none; }
  }

  @keyframes idle-layer {
    0%, 24% { opacity: 1; transform: none; }
    30%, 92% { opacity: 0; transform: scale(0.98); }
    100% { opacity: 1; transform: none; }
  }

  @keyframes active-layer {
    0%, 24% { opacity: 0; transform: translateY(8px); }
    32%, 88% { opacity: 1; transform: none; }
    94%, 100% { opacity: 0; transform: translateY(8px); }
  }

  @keyframes file-in {
    0%, 36% { opacity: 0; transform: translateY(4px); }
    42%, 100% { opacity: 1; transform: none; }
  }

  @keyframes file-in-2 {
    0%, 52% { opacity: 0; transform: translateY(4px); }
    58%, 100% { opacity: 1; transform: none; }
  }

  @keyframes file-in-3 {
    0%, 68% { opacity: 0; transform: translateY(4px); }
    74%, 100% { opacity: 1; transform: none; }
  }

  @keyframes live-ping {
    0% { opacity: 0.6; transform: scale(1); }
    80%, 100% { opacity: 0; transform: scale(2.6); }
  }

  @media (prefers-reduced-motion: reduce) {
    .layer-active { opacity: 1; }
    .live-dot::after { animation: none; opacity: 0; }
  }
</style>
