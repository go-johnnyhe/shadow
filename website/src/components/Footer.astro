---
import { dmgUrl, githubUrl, marketplaceUrl } from '../consts';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const groups = [
  {
    title: 'Get Shadow',
    links: [
      { label: 'Download for Mac', href: dmgUrl, target: 'download_mac' },
      { label: 'All releases', href: `${githubUrl}/releases/latest`, target: 'github_releases', external: true },
      { label: 'VS Code extension', href: marketplaceUrl, target: 'vscode_marketplace', external: true },
    ],
  },
  {
    title: 'Project',
    links: [
      { label: 'Source on GitHub', href: githubUrl, target: 'github', external: true },
      { label: 'Report an issue', href: `${githubUrl}/issues`, target: 'github_issues', external: true },
      { label: 'Documentation', href: `${githubUrl}#readme`, target: 'github_docs', external: true },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy', href: `${base}privacy/`, target: 'privacy' },
      { label: 'MIT License', href: `${githubUrl}/blob/main/LICENSE`, target: 'license', external: true },
    ],
  },
];
---

<footer class="footer">
  <div class="shell footer-inner">
    <div class="footer-brand">
      <a href={base} class="footer-logo">
        <img src={`${base}shadow-icon.png`} alt="" width="24" height="24" loading="lazy" />
        Shadow
      </a>
      <p>Live pairing where everyone keeps their own editor.</p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      {groups.map((g) => (
        <div>
          <p class="footer-title">{g.title}</p>
          <ul role="list">
            {g.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target={l.external ? '_blank' : undefined}
                  rel={l.external ? 'noopener noreferrer' : undefined}
                  data-cta
                  data-cta-source="footer"
                  data-cta-target={l.target}
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>
</footer>

<style>
  .footer {
    padding: var(--sp-700) 0 var(--sp-800);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-600);
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-75);
    font-weight: 600;
    color: var(--text);
  }

  .footer-logo img {
    border-radius: var(--r-md);
  }

  .footer-brand p {
    max-width: 280px;
    margin-top: var(--sp-100);
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
    color: var(--text-muted);
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: var(--sp-700);
  }

  .footer-title {
    margin-bottom: var(--sp-100);
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
    font-weight: 600;
    color: var(--text);
  }

  .footer-nav ul {
    display: grid;
    gap: var(--sp-75);
    list-style: none;
  }

  .footer-nav a {
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease);
  }

  .footer-nav a:hover {
    color: var(--text);
  }

  @media (max-width: 767px) {
    .footer {
      padding: var(--sp-600) 0 var(--sp-700);
    }

    .footer-inner {
      flex-direction: column;
      gap: var(--sp-500);
    }

    .footer-nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--sp-400) var(--sp-300);
    }
  }
</style>
