---
import { dmgUrl, githubUrl, installCmd } from '../consts';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const iconSrc = `${base}shadow-icon.png`;
---

<section class="cta" id="install">
  <div class="section-shell cta-inner reveal">
    <div class="brand-mark reveal" data-brand-mark data-particle-src={iconSrc} aria-hidden="true">
      <canvas class="brand-mark-canvas" data-brand-canvas></canvas>
      <img class="brand-mark-fallback" src={iconSrc} alt="" width="200" height="200" loading="lazy" decoding="async" />
    </div>

    <p class="cta-lead">
      Next time someone says "let's pair," try Shadow.
      Download, click Start, send the link.
    </p>

    <div class="cta-actions reveal r-d1">
      <a
        href={dmgUrl}
        class="primary-button"
        data-cta
        data-cta-source="final_cta"
        data-cta-target="download_mac"
        data-cta-surface="website"
      >
        Download for Mac
      </a>
      <a
        href={`${githubUrl}#readme`}
        class="ghost-button"
        target="_blank"
        rel="noopener noreferrer"
        data-cta
        data-cta-source="final_cta"
        data-cta-target="github_docs"
        data-cta-surface="website"
      >
        Read the docs on GitHub &rarr;
      </a>
    </div>

    <div class="cli-copy reveal r-d2">
      <code>{installCmd}</code>
      <button
        type="button"
        class="secondary-button copy-button"
        data-copy-text={installCmd}
        data-copy-source="final_cta"
        data-copy-target="cli_install"
        data-copy-surface="website"
      >
        <span data-copy-label>Copy CLI install</span>
      </button>
    </div>

    <div class="cta-muted reveal r-d3">
      <span>Also available as a <a href={`${githubUrl}#install`} class="muted-link" target="_blank" rel="noopener noreferrer">CLI</a></span>
      <span class="sep">&middot;</span>
      <a
        href={githubUrl}
        class="muted-link"
        target="_blank"
        rel="noopener noreferrer"
        data-cta
        data-cta-source="final_cta"
        data-cta-target="github"
        data-cta-surface="website"
      >
        Star the repo, it helps others find Shadow
      </a>
    </div>
  </div>
</section>

<script>
  const mount = document.querySelector('[data-brand-mark]');
  const canvas = mount?.querySelector('[data-brand-canvas]');
  const src = mount?.getAttribute('data-particle-src') ?? '';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function webglAvailable() {
    try {
      const test = document.createElement('canvas');
      return (
        !!window.WebGLRenderingContext &&
        !!(test.getContext('webgl') || test.getContext('experimental-webgl'))
      );
    } catch {
      return false;
    }
  }

  // Only enhance when it's safe: real canvas, an asset, motion allowed, WebGL present.
  // Otherwise the static icon (fallback <img>) stays exactly as-is.
  if (mount && canvas instanceof HTMLCanvasElement && src && !reduceMotion && webglAvailable()) {
    let started = false;

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting || started) continue;
          started = true;
          io.disconnect();

          // Dynamic import keeps three.js in its own lazily-loaded chunk,
          // off the initial page load.
          import('./canvasui/ParticleObjectVanilla')
            .then(({ createParticleObject }) => {
              const instance = createParticleObject(
                { canvas },
                {
                  src,
                  count: 12000,
                  size: 2.2,
                  color: '',
                  background: '',
                  orbit: false,
                  zoom: false,
                  autoRotate: false,
                  floatIntensity: 1.1,
                  rotationIntensity: 0.5,
                  floatSpeed: 1.4,
                  swirl: 0.7,
                  onLoad: () => {
                    mount.setAttribute('data-state', 'ready');
                    instance?.resize();
                  },
                }
              );

              // createParticleObject returns null if WebGL init fails — keep the static icon.
              if (!instance) return;

              const onResize = () => instance.resize();
              window.addEventListener('resize', onResize, { passive: true });
              instance.resize();
            })
            .catch(() => {
              /* import/init failed — the static icon stays visible */
            });
        }
      },
      { rootMargin: '200px 0px' }
    );

    io.observe(mount);
  }
</script>

<style>
  .cta {
    margin-bottom: clamp(10rem, 16vw, 16rem);
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* ---- Brand mark (Canvas UI particle object) ---- */
  .brand-mark {
    position: relative;
    width: clamp(190px, 28vw, 300px);
    aspect-ratio: 1;
    margin-bottom: clamp(2.25rem, 5vw, 3.75rem);
  }

  .brand-mark-canvas,
  .brand-mark-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .brand-mark-canvas {
    opacity: 0;
    transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    touch-action: pan-y;
  }

  .brand-mark-fallback {
    object-fit: contain;
    border-radius: 22%;
    opacity: 1;
    transition: opacity 0.7s ease;
  }

  .brand-mark[data-state='ready'] .brand-mark-canvas {
    opacity: 1;
  }

  .brand-mark[data-state='ready'] .brand-mark-fallback {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-mark-canvas {
      display: none;
    }

    .brand-mark-fallback {
      opacity: 1;
    }
  }

  .cta-lead {
    max-width: 36rem;
    margin: 1.25rem 0 2.5rem;
    color: var(--text-secondary);
    font-size: 1.15rem;
    line-height: 1.6;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .cli-copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    width: min(100%, 46rem);
    margin-top: 1.4rem;
    padding: 0.55rem;
    border: 1px solid var(--border);
    border-radius: 0.7rem;
    background: var(--paper);
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.12);
  }

  .cli-copy code {
    padding-left: 0.8rem;
    overflow: hidden;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-align: left;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .copy-button {
    min-height: 2.65rem;
    padding: 0.65rem 0.95rem;
    white-space: nowrap;
  }

  .cta-muted {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    flex-wrap: wrap;
    justify-content: center;
  }

  .muted-link {
    color: var(--text-secondary);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 2px;
    transition: color 0.2s ease;
  }

  .muted-link:hover {
    color: var(--text);
    opacity: 1;
  }

  .sep {
    color: var(--border-strong);
  }

  @media (max-width: 720px) {
    .cli-copy {
      grid-template-columns: 1fr;
      padding: 0.8rem;
    }

    .cli-copy code {
      width: 100%;
      padding: 0;
      white-space: normal;
      word-break: break-all;
    }

    .copy-button {
      width: 100%;
    }
  }
</style>
